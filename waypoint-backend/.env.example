# Only used when running the API directly on the host (`npm run dev`, or
# any of the db: scripts). The Dockerized api service ignores this file —
# it sets its own DATABASE_URL/PORT in docker-compose.yml, pointing at the
# postgres service's compose-network hostname instead of localhost.
#
# Ports are 15432/14000, not Postgres/Express's conventional 5432/4000 —
# picked to avoid colliding with another project's stack already claiming
# the standard ports on the same dev machine (see docker-compose.yml).
DATABASE_URL=postgres://waypoint:waypoint@localhost:15432/waypoint
PORT=14000

# Bind address. Defaults to 127.0.0.1 — this process has no auth, so binding
# every interface here would put proposal approval on the LAN for any
# non-browser client (see src/app.ts's CORS comment). Uncomment only if you
# specifically need to reach this API from another machine.
# HOST=0.0.0.0

# Comma-separated list of origins allowed to call this API (see the CORS
# setup in src/app.ts). Optional — uncomment only to override the default,
# which already covers both the webpack dev server and the packaged
# desktop app's app://waypoint scheme.
# CORS_ORIGIN=http://localhost:11212,app://waypoint

# Encryption key for third-party secrets this process stores (AT12,
# ROAD-147: a hosted member's own Jira API token — see
# src/services/memberCredentials.service.ts and src/lib/secretBox.ts).
# Optional, and normally left unset: with neither of these set, a 32-byte key
# is generated on first use and written to ~/.waypoint/secret.key with 0600
# permissions. Copilot's Jira read tools on the DESKTOP path still use the
# credential the desktop app holds in the OS keychain, borrowed per request
# over an MCP header (see src/lib/jira/credentialHeader.ts) — this key is
# only for the separate, hosted-member credential a Team workspace member
# connects directly to this backend.
#
# Set WAYPOINT_SECRET_KEY (32 bytes, base64) to manage the key yourself — e.g.
# to inject it from a secret manager, or to keep it off disk entirely. Set
# WAYPOINT_KEY_FILE to move the generated file somewhere else, which is what
# the Dockerized api service needs if the connection should survive the
# container's filesystem being recreated (the default path lives inside the
# container). Losing the key is survivable: a stored credential simply stops
# opening and reports itself as needing to be reconnected.
# WAYPOINT_SECRET_KEY=
# WAYPOINT_KEY_FILE=

# --- Accounts (AT8, ROAD-143; sign-in itself lands in AT9) ---------------
# First-run setup on a self-hosted instance is gated on this token: the
# person completing the setup wizard sends it as a bearer token to
# POST /instance/setup. Whoever holds this file owns the instance — the
# same trust boundary as DATABASE_URL. Leave unset and setup answers 503.
# Cloud pre-provisions its instance row, so it never needs this.
# INSTANCE_SETUP_TOKEN=change-me
#
# Which sign-in methods the instance offers is computed from these — each
# pair is independently optional, at least one must be set or setup
# refuses to produce an instance nobody can sign into. Values are yours
# (a GitHub OAuth App, a Google Cloud OAuth client, any SMTP relay).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_FROM=
#
# --- Sign-in (AT9, ROAD-144) ---------------------------------------------
# The URL GitHub/Google send the browser back to and the magic link points
# at — this backend as reached from a browser. Register
# <PUBLIC_BASE_URL>/auth/github/callback and /auth/google/callback with
# each provider. Defaults to http://localhost:<PORT> for local dev.
# PUBLIC_BASE_URL=https://waypoint.example.com
#
# Optional SMTP details beyond SMTP_HOST/SMTP_FROM above. Port 465 is
# implicit TLS; anything else starts plain and upgrades with STARTTLS.
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
