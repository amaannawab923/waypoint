*.scss.d.ts

# eslint ignores hidden directories by default:
# https://github.com/eslint/eslint/issues/8429
!.erb

# Fetched by hash, never committed (see .gitignore): the pinned agent-engine
# archive and the vendored emdash chat-ui build. Both carry minified
# bundles that `eslint .` would otherwise spend minutes on — CI's lint step
# hung on them (PR #56).
# Root-anchored: a bare `engine` would also ignore src/main/engine/.
/engine
/vendor
# Webpack's dev output for the renderer's own workspace.
/release/app/.erb
